# Agora: conexao PostgreSQL usada pelas rotas seguras da Vercel.
DATABASE_URL=postgresql://usuario:senha@servidor:5432/banco

# Ative assim que o servidor PostgreSQL oferecer conexoes TLS/SSL.
DATABASE_SSL=false

# Futuro: endereco HTTPS do FastAPI na VM. Se preenchido, o site usa a API
# em vez da conexao direta ao banco.
APP_MIX_API_URL=

# Chave lida apenas pelas rotas de servidor do Next.js.
APP_MIX_API_KEY=troque-por-uma-chave-forte

# Bearer exclusivo da API de Consulta SQL do Integrador. Nunca use NEXT_PUBLIC_.
INTEGRADOR_QUERY_BEARER=

# Opcional apenas no desenvolvimento local: permite extrair a configuracao do EXE instalado.
INTEGRADOR_DESKTOP_EXE=C:\mix fiscal\integracao\desktop-integrador.exe

# Login temporario do painel. Troque os dois valores antes de publicar.
APP_MIX_ADMIN_EMAIL=admin@suaempresa.com.br
APP_MIX_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Segredo aleatorio com pelo menos 32 caracteres para assinar a sessao.
APP_MIX_SESSION_SECRET=gere-um-segredo-aleatorio-com-32-caracteres
